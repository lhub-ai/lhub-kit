  {
   "annotations": {
    "destructiveHint": false,
    "idempotentHint": false,
    "openWorldHint": false,
    "readOnlyHint": false,
    "title": "Request owner confirmation link"
   },
   "description": "Get a one-time approval link for a deal you hired that waits in AWAITING_CONFIRM.\n\n    A hire that stops in AWAITING_CONFIRM already returns one: give the user the\n    link `hire` returned, to open themselves; call `owner_link` (no separate\n    go-ahead \u2014 it moves no money) only when `hire` returned none, or later on the\n    user's request or after expiry, so one hire mints one link. Never open, fetch\n    or POST the link yourself, with any tool; only the user opens it. Each link\n    works once, until its expires_at; calling again replaces it.\n    ",
   "inputSchema": {
    "properties": {
     "deal_id": {
      "title": "Deal Id",
      "type": "string"
     }
    },
    "required": [
     "deal_id"
    ],
    "title": "mcp_owner_linkArguments",
    "type": "object"
   },
   "name": "owner_link",
   "outputSchema": {
    "additionalProperties": true,
    "title": "mcp_owner_linkDictOutput",
    "type": "object"
   },
   "title": "Request owner confirmation link"
  },
